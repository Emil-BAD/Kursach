# -*- coding: utf-8 -*-
# Пример файла .env для API

# ===== СЕКРЕТЫ (МЕНЯЙ В PRODUCTION!) =====
SECRET_KEY=your-super-secret-key-change-in-production-12345
DEBUG=False

# ===== БАЗА ДАННЫХ =====
DATABASE_URL=postgresql://user:password@localhost:5432/dormitory_db

# ===== CORS (ФРОНТЕНД ДОМЕНЫ) =====
# Перечисли домены через запятую (без пробелов)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ===== ТОКЕНЫ =====
# Access token: 15 минут
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token: 30 дней
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== CLOUDINARY (для загрузки изображений) =====
# Если не используешь Cloudinary, оставь пустыми
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
